<file path="client/lib/validations/schemas.ts">
import { z } from 'zod';

export const propertySchema = z.object({
  title: z.string().min(1, 'Title is required'),
  description: z.string().optional(),
  price: z.number().positive('Price must be a positive number'),
  location: z.string().optional(),
  availability: z.boolean().optional(),
  image_urls: z.array(z.string().url()).optional(),
});

export const printingOrderSchema = z.object({
  customer_name: z.string().min(1, 'Customer name is required'),
  email: z.string().email('Invalid email address'),
  product_type: z.enum(['t-shirt', 'mug', 'banner', 'poster']),
  quantity: z.number().int().positive('Quantity must be a positive integer'),
  design_url: z.string().url().optional(),
  status: z.enum(['pending', 'processing', 'completed']).optional(),
  total_price: z.number().positive('Total price must be a positive number'),
});
